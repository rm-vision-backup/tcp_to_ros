<launch>
  <!-- Group A 多 Master 仿真拓扑 launch (属于 tcp_to_ros 地面站主功能包示例)
       每个 ROS Master 启动一次, 通过 uav_name 区分角色:
       - UAV1/UAV2/UAV3 Master: 运行通用 bridge (UAV 角色) + 单机 mock executor
       - GCS_A Master: 运行通用 bridge (GCS_A 角色), 由用户另行启动 gcs_a_backend_node/tcp_server_node
       bridge 为通用包 swarm_topology_bridge 的 bridge_node, 按本包 config 动态解析类型。
       ROS_MASTER_URI 与 ZMQ port_offset 共同区分同一台机器上的多个 Master。

       命名约定:
       - 单机 executor 提供 /UAV{n}/uav_task 与 /UAV{n}/uav_hold Service
       - 单机 executor 发布全局 /uav_task_state Topic (bridge 订阅该名)
       - GCS_A 侧 bridge 转发为 /UAV{n}/uav_task_state, 供 GCS_A backend 订阅 -->

  <arg name="uav_name" default="UAV1" />
  <arg name="uav_id" default="A01" />
  <arg name="config" default="$(find tcp_to_ros)/config/topology_group_a_sim.yaml" />
  <arg name="run_uav_mock" default="true" />

  <!-- 1. 通用桥接节点 (Topic 桥 + Service 代理, 来自 swarm_topology_bridge) -->
  <node pkg="swarm_topology_bridge" type="bridge_node.py" name="swarm_bridge" output="screen">
    <rosparam file="$(arg config)" command="load" />
    <param name="uav_name" value="$(arg uav_name)" />
  </node>

  <!-- 2. 单机 mock executor (仅 UAV* 角色, 默认启动; GCS_A 角色关闭) -->
  <group if="$(eval arg('run_uav_mock') and arg('uav_name') != 'GCS_A')">
    <include file="$(find swarm_uav_executor)/launch/uav_executor_mock.launch">
      <arg name="exec_target" value="$(arg uav_name)" />
      <arg name="uav_id" value="$(arg uav_id)" />
      <!-- executor 发布全局状态 Topic, 由 bridge 订阅后转发给 GCS_A -->
      <arg name="state_topic" value="/uav_task_state" />
      <arg name="result_delay_s" value="0.5" />
      <arg name="message" value="mock $(arg uav_name) task finished" />
      <arg name="safety_lease_required" value="true" />
    </include>
    <node pkg="tcp_to_ros" type="mock_mavros_state_node.py" name="mock_mavros_state" output="screen">
      <param name="topic" value="/mavros/state" />
    </node>
  </group>
</launch>

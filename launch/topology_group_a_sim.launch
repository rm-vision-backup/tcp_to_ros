<launch>
  <!-- Group A 多 Master 仿真拓扑 launch（兼容入口，保持 run.sh/uav_offboard_ego.launch 引用）。
       topology 唯一 owner 已迁移到 swarm_topology_bridge（implementation_plan_26082916 §7）；
       本文件只做桥接 include + 可选 mock executor 组合，不再保存 topology 内容。 -->
  <arg name="uav_name" default="UAV1" />
  <arg name="uav_id" default="A01" />
  <arg name="config" default="$(find swarm_topology_bridge)/config/topology_group_a_sim.yaml" />
  <arg name="run_uav_mock" default="true" />

  <!-- 1. 通用桥接节点（Topic 桥 + Service 代理，owner=swarm_topology_bridge） -->
  <include file="$(find swarm_topology_bridge)/launch/topology_group_a_sim.launch">
    <arg name="uav_name" value="$(arg uav_name)" />
    <arg name="config" value="$(arg config)" />
  </include>

  <!-- 2. 单机 mock executor（仅 UAV* 角色，默认启动；GCS_A 角色关闭） -->
  <group if="$(eval arg('run_uav_mock') and arg('uav_name') != 'GCS_A')">
    <include file="$(find swarm_uav_executor)/launch/uav_executor_mock.launch">
      <arg name="exec_target" value="$(arg uav_name)" />
      <arg name="uav_id" value="$(arg uav_id)" />
      <!-- executor 发布全局状态 Topic, 由 bridge 订阅后转发给 GCS_A -->
      <arg name="state_topic" value="/uav_task_state" />
      <arg name="result_delay_s" value="0.5" />
      <arg name="message" value="mock $(arg uav_name) task finished" />
    </include>
    <node pkg="tcp_to_ros" type="mock_mavros_state_node.py" name="mock_mavros_state" output="screen">
      <param name="topic" value="/mavros/state" />
    </node>
  </group>
</launch>

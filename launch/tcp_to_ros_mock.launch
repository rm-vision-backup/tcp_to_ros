<launch>
  <!-- canonical transport 默认（transport_defaults.yaml）；host/port/action/state/hold
        arg 默认空，仅命令行显式传入时条件写入；mock_config 为 path 保留默认。 -->
  <arg name="mock_config" default="$(find tcp_to_ros)/config/mock_backend.yaml" />
  <arg name="host" default="" />
  <arg name="port" default="" />
  <arg name="action_name" default="" />
  <arg name="state_topic" default="" />
  <arg name="emergency_hold_service" default="" />

  <rosparam command="load" file="$(arg mock_config)" />

  <node pkg="tcp_to_ros" type="mock_backend_node.py" name="mock_backend_node" output="screen">
    <param name="action_name" value="$(arg action_name)" if="$(eval arg('action_name') != '')" />
    <param name="state_topic" value="$(arg state_topic)" if="$(eval arg('state_topic') != '')" />
    <param name="emergency_hold_service" value="$(arg emergency_hold_service)" if="$(eval arg('emergency_hold_service') != '')" />
  </node>

  <node pkg="tcp_to_ros" type="tcp_server_node.py" name="tcp_server_node" output="screen">
    <!-- canonical transport 默认（transport_defaults.yaml）；launch 作 deployment override。 -->
    <rosparam command="load" file="$(find tcp_to_ros)/config/transport_defaults.yaml" />
    <param name="host" value="$(arg host)" if="$(eval arg('host') != '')" />
    <param name="port" value="$(arg port)" if="$(eval arg('port') != '')" />
    <param name="action_name" value="$(arg action_name)" if="$(eval arg('action_name') != '')" />
    <param name="state_topic" value="$(arg state_topic)" if="$(eval arg('state_topic') != '')" />
    <param name="emergency_hold_service" value="$(arg emergency_hold_service)" if="$(eval arg('emergency_hold_service') != '')" />
  </node>
</launch>

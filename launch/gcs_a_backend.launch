<launch>
  <!-- GCS_A 本地整组分发后端: 接收 ExecuteGroupTask Action, 按身份映射并发分发到各 UAV -->
  <!-- canonical backend/link health 默认（backend_defaults.yaml）；launch 仅 identity/path/
       deployment override（map_file/formation_offsets_file 等）。业务参数（action_name/
       emergency_hold_service/confirm_*/require_calibration_ready）arg 默认空，仅命令行显式
       传入时条件写入，不保存第二套默认（implementation_plan_26083018 §3）。 -->
  <arg name="map_file" default="$(find tcp_to_ros)/config/uav_identity_map.yaml" />
  <arg name="formation_offsets_file" default="$(find tcp_to_ros)/config/formation_offsets.yaml" />

  <arg name="action_name" default="" />
  <arg name="emergency_hold_service" default="" />
  <arg name="confirm_wait_s" default="" />
  <arg name="confirm_retries" default="" />
  <arg name="confirm_retry_interval_s" default="" />
  <arg name="confirm_deadline_s" default="" />
  <arg name="require_calibration_ready" default="" />

  <node pkg="tcp_to_ros" type="gcs_a_backend_node.py" name="gcs_a_backend_node" output="screen">
    <!-- canonical backend/link health 默认（backend_defaults.yaml）；launch 仅
         identity/path/deployment override（map_file/formation_offsets_file 等）。 -->
    <rosparam command="load" file="$(find tcp_to_ros)/config/backend_defaults.yaml" />
    <param name="map_file" value="$(arg map_file)" />
    <param name="formation_offsets_file" value="$(arg formation_offsets_file)" />
    <param name="action_name" value="$(arg action_name)" if="$(eval arg('action_name') != '')" />
    <param name="emergency_hold_service" value="$(arg emergency_hold_service)" if="$(eval arg('emergency_hold_service') != '')" />
    <param name="confirm_wait_s" value="$(arg confirm_wait_s)" if="$(eval arg('confirm_wait_s') != '')" />
    <param name="confirm_retries" value="$(arg confirm_retries)" if="$(eval arg('confirm_retries') != '')" />
    <param name="confirm_retry_interval_s" value="$(arg confirm_retry_interval_s)" if="$(eval arg('confirm_retry_interval_s') != '')" />
    <param name="confirm_deadline_s" value="$(arg confirm_deadline_s)" if="$(eval arg('confirm_deadline_s') != '')" />
    <param name="require_calibration_ready" value="$(arg require_calibration_ready)" if="$(eval arg('require_calibration_ready') != '')" />
  </node>

  <node pkg="tcp_to_ros" type="gcs_a_calibration_node.py"
        name="gcs_a_calibration" output="screen" required="true" />
</launch>

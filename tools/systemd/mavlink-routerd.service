# mavlink-routerd —— UAV 机载 MAVLink 路由（FCU 串口 ↔ 地面站 / 本机 mavros）
#
# 为什么改成 systemd 服务（取代"桌面自启 + gnome-terminal 前台脚本"）：
# 旧方案的失效链条是——脚本退出 → 标签页关闭 → systemd 的 vte-spawn-*.scope 被撤销 →
# cgroup 把 router 一起杀掉（`setsid` 只换会话、换不掉 cgroup；见 2026-09-23 报告 §1）。
# 做成系统服务后：**开机即起、不依赖图形登录、不依赖窗口常开**，也天然满足
# "router 必须先于机载栈（mavros）"的顺序要求（栈是人工/onboard_ctl 起的，晚于开机）。
#
# 参数与现场定稿脚本（~/Mavlink_Routerd_Sh/Mavlink-route.sh，2026-09-23 版）基本一致；
# 差别：① 2026-10-10 起去掉 `-e 192.168.5.242:15500`——.242 无任何消费者（本机 mavros 走
# 127.0.0.1、GCS 走 .241），是飞控遥测（~46 KB/s/机）在空口上的纯冗余拷贝，见 2026-09-22
# 报告 §5.3 与 2026-10-10 三机链路停摆分析报告；② 以 root 运行，不再需要先
# `chmod 777 /dev/ttyTHS0`；也不再需要"前台阻塞"那种约束。
#
# 部署：bash src/tcp_to_ros/tools/router_service_install.sh 8 10 13   （从 GCS 跑，逐台）
# 判活：systemctl is-active mavlink-routerd   /   pgrep -x mavlink-routerd
#       （不要用 `ss -lunp | grep 15500`：它的 UDP 是 connect 出去的 socket，不在 LISTEN）
# 日志：journalctl -u mavlink-routerd -b

[Unit]
Description=mavlink-routerd (UAV onboard MAVLink router: FCU UART <-> GCS 15500 / local mavros)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/nvidia/Mavlink_Routerd_Sh
ExecStart=/home/nvidia/Mavlink_Routerd_Sh/mavlink-routerd -e 192.168.5.241:15500 -e 127.0.0.1:15500 /dev/ttyTHS0:921600
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

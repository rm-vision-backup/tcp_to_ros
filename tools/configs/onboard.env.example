# 机载运维参数文件（机载电脑账号/密码全机相同，只记一份）
#
# 用法：onboard_clock_fix.sh / log_fetch.sh / onboard_ctl.sh 都默认读 tools/configs/onboard.env；
#   首次使用：cp onboard.env.example onboard.env && chmod 600 onboard.env
#   注意：onboard.env 含明文密码，已在 .gitignore 中排除，**不要提交、不要 push**。

# —— ssh 登录（openssh）——
BOARD_SSH_USER=CHANGE_ME
BOARD_SSH_PASS=CHANGE_ME

# —— 远端 sudo（写系统时钟与 RTC 都需要 root）——
# 若机载已配置免密 sudo，可留空 → 脚本改用 `sudo -n`
BOARD_SUDO_PASS=CHANGE_ME

# —— ssh 连接超时（秒）——
SSH_TIMEOUT=8

# —— UAVn 的 IP 规则：UAVn = IP_PREFIX.(IP_STRIDE * n + IP_OFFSET) ——
# 现场约定（real_setup §1）：UAV1=192.168.5.11 ... UAV16=192.168.5.161
IP_PREFIX=192.168.5
IP_STRIDE=10
IP_OFFSET=1

# —— 时钟修正容差（秒）——
# TOLERANCE_S：板钟与该台写入前现取的本机（GCS）基准之差超过它判 FAIL（默认 5）。
#   故意放宽、不要求秒级：机间 intent 对齐由 gps_bias 修正（系统钟偏差在差分里抵消），
#   参考 swarm 规划器 10 s 才判「不同步」，本机 driver 的 intent 接收窗是 ±30 s。
#   详见 tools/README.md §5。
# RTC_TOLERANCE_S：RTC 回读与板钟之差超过它判 FAIL（默认 5）。
TOLERANCE_S=5

# —— RTC 设备候选（空格分隔，按序探测；都不存在则只能修系统时钟，重启仍回 1970）——
RTC_CANDIDATES="/dev/rtc /dev/rtc0 /dev/rtc1"

# —— 机载 ROS 工作空间（只有 onboard_ctl.sh 用）——
# 留空 = 由**机载**用 $HOME 展开 ~/catkin_swarm6-2（推荐：机载用户名变了也不用改这里）；
# 填了就用字面值，必须是机载上的绝对路径（本机不会替你展开 ~ 或 $HOME）。
ONBOARD_WS=
